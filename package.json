{
  "name": "rift-manager",
  "version": "1.0.0",
  "description": "Game quản lý đội tuyển LMHT chuyên nghiệp chạy trên trình duyệt, **mặc định tiếng Việt** và có thể đổi sang **tiếng Anh** (nút 🇻🇳/🇬🇧 ở góc trên).",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stats": "tsx scripts/engine-stats.ts",
    "build:artifact": "vite build && node scripts/artifact-page.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdhai03/lol_manager.git"
  },
  "bugs": {
    "url": "https://github.com/hdhai03/lol_manager/issues"
  },
  "homepage": "https://github.com/hdhai03/lol_manager#readme",
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "private": true,
  "type": "module"
}
